{
	"name": "joaommota-next-website",
	"version": "0.1.0",
	"private": true,
	"husky": {
		"hooks": {
			"pre-commit": "lint-staged"
		}
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,json,css,grit}": [
			"biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
		]
	},
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "biome ci && node --test scripts/*.contract.mjs",
		"typecheck": "tsc --noEmit",
		"format": "biome check --write"
	},
	"dependencies": {
		"airtable": "^0.10.1",
		"next": "10.0.5",
		"next-i18next": "^7.0.1",
		"react": "17.0.1",
		"react-burger-menu": "^3.0.3",
		"react-dom": "17.0.1",
		"react-hook-form": "^6.14.1",
		"react-reveal": "^1.2.2",
		"react-scroll": "^1.8.1",
		"react-visibility-sensor": "^5.1.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.7",
		"@types/node": "^14.14.14",
		"@types/react": "^17.0.0",
		"autoprefixer": "^10.1.0",
		"code": "^5.2.4",
		"postcss": "^8.2.1",
		"postcss-preset-env": "^6.7.0",
		"tailwindcss": "^2.0.2",
		"typescript": "^4.1.3"
	}
}
